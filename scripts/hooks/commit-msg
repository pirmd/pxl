#!/bin/sh

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Format: type(scope): description (ex: feat(gfx): add circle drawing)
if ! echo "$COMMIT_MSG" | grep -qE '^(feat|fix|refactor|docs|test|chore)(\([a-z0-9]+\\))?: .+'; then
    echo "❌ Commit message must follow format: type(scope): description"
    echo "   Example: feat(gfx): add circle drawing"
    echo "   Types: feat, fix, refactor, docs, test, chore"
    exit 1
fi
